# HomeLab Command Centre - deployment configuration.
# Copy to deploy/.env (never commit the real file) and adjust. All values below are placeholders.

# ---- Access -------------------------------------------------------------------------------
# Port the web UI listens on (host side). Bind to your Tailscale IP to avoid exposing on the LAN,
# e.g. WEB_BIND=100.101.102.103  (find yours with `tailscale ip -4`). 127.0.0.1 = local only.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# URL clients (Android app, browser) use to reach the API/UI. Informational: shown by /api/v1/health
# and in the app's connection screen. Example: http://homelab.tailnet-name.ts.net:8080
HOMELAB_PUBLIC_URL=

# Set to true once you serve the UI over HTTPS (e.g. `tailscale serve`); required for Secure cookies.
HOMELAB_COOKIE_SECURE=false

# ---- Secrets (generate your own!) -----------------------------------------------------------
# JWT signing key, >= 32 chars. Leave empty to auto-generate and persist in the data volume.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HOMELAB_SECRET_KEY=
# Optional: if set, the first-run setup page requires this token (prevents a LAN neighbour
# from claiming the admin account before you do). Remove from the file after setup if you like.
HOMELAB_SETUP_TOKEN=

# ---- Docker integration ---------------------------------------------------------------------
# Master switch for start/stop/restart. Default off = strictly read-only monitoring.
# To enable, set BOTH of these to the "on" values; then opt each container in per service.
HOMELAB_DOCKER_CONTROL_ENABLED=false
DOCKER_PROXY_ALLOW_ACTIONS=0

# ---- Host paths ----------------------------------------------------------------------------
# A path inside the backend container that lives on the host's ROOT filesystem; it is used for the
# "root filesystem usage" probe. The default (/data, a Docker volume under /var/lib/docker) is
# correct when Docker's data-root is on the root disk. See docs/DEPLOYMENT.md.
HOMELAB_ROOT_PATH=/data

# ---- Optional Telegram notifications (leave empty to disable) --------------------------------
HOMELAB_TELEGRAM_BOT_TOKEN=
HOMELAB_TELEGRAM_CHAT_ID=
